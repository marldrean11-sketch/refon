{
  "name": "refon",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @refon/frontend",
    "dev:backend": "npm run dev --workspace @refon/backend",
    "build:frontend": "npm run build --workspace @refon/frontend",
    "prisma:seed": "npm run prisma:seed --workspace @refon/backend",
    "test:auth": "npm run test:auth --workspace @refon/backend",
    "test:marketplace": "npm run test:marketplace --workspace @refon/backend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  },
  "allowScripts": {
    "prisma@6.12.0": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
