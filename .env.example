# Copy to .env and fill in every value marked REQUIRED.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Database ----------------------------------------------------------------
# REQUIRED. Password for the compose-managed PostgreSQL container.
# It must not be empty; compose refuses to start without it.
POSTGRES_PASSWORD=

# --- API ---------------------------------------------------------------------
# REQUIRED. At least 32 characters. Changing it signs every user out.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# REQUIRED. Public origin the browser uses, with no trailing slash.
# In production this is the same origin nginx serves, so it should match WEB_PORT's URL.
APP_URL=http://localhost:8080

# REQUIRED. Comma-separated list of origins allowed to send credentialed requests.
# Same-origin deployments only need the APP_URL value.
CLIENT_URL=http://localhost:8080

# --- Email -------------------------------------------------------------------
# REQUIRED. The From header on password reset and verification mail.
MAIL_FROM="ReFon <no-reply@example.com>"

# The API refuses to boot in production without SMTP_HOST. For local experiments you
# can point it at a host that accepts mail; leave it empty only if you intend to read
# the outbox file in the mailoutbox volume.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Photo storage -----------------------------------------------------------
# local writes into the `uploads` volume and needs that volume to persist.
# s3 is the right choice where the filesystem is ephemeral.
STORAGE_DRIVER=local

# Only read when STORAGE_DRIVER=s3. The API requires the four essentials below.
S3_BUCKET=
S3_REGION=
# Set for Cloudflare R2, Backblaze B2, or MinIO; empty for real AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=uploads/

# --- Web ---------------------------------------------------------------------
# Host port for the nginx container. 8080 avoids colliding with a local dev server.
WEB_PORT=8080

# --- First admin (optional) --------------------------------------------------
# Used only by `docker compose exec backend npm run admin:create -w backend`.
# ADMIN_PASSWORD must be at least 12 characters. Leave commented for day-to-day runs.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=ReFon Administrator