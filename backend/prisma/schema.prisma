generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum SellerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
}

enum NotificationType {
  NEW_INQUIRY
  INQUIRY_SENT
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_SOLD
  SELLER_APPROVED
  SELLER_REJECTED
  LISTING_TAKEN_DOWN
  REPORT_RESOLVED
}

enum ReportReason {
  SCAM
  MISLEADING
  WRONG_INFO
  PROHIBITED_ITEM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// ReFon condition grading scale. A is the best tier.
enum ConditionGrade {
  A
  B
  C
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(120)
  email             String    @unique @db.VarChar(320)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  /// Null until the address is confirmed through a verification link.
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Used to invalidate sessions issued before a password change.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  role              UserRole  @default(BUYER)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller         Seller?
  notifications  Notification[]
  buyerInquiries Inquiry[]      @relation("BuyerInquiries")
  favorites      Favorite[]
  reportsMade    Report[]        @relation("ReportReporter")
  reportsHandled Report[]        @relation("ReportResolver")
  authTokens     AuthToken[]
  reviews        Review[]
  carts          Cart[]

  @@map("users")
}

model Seller {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  businessName       String                   @map("business_name") @db.VarChar(160)
  contactInfo        String                   @map("contact_info") @db.VarChar(320)
  verificationStatus SellerVerificationStatus @default(PENDING) @map("verification_status")
  moderatorFeedback  String?                  @map("moderator_feedback") @db.Text
  /// Public storefront details. Null fields are simply not shown.
  city               String?                  @db.VarChar(120)
  region             String?                  @db.VarChar(120)
  tagline            String?                  @db.VarChar(200)
  /// Denormalised from completed orders so the catalog can sort by rating
  /// without joining through the order table on every query.
  ratingAverage      Decimal                  @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int                      @default(0) @map("rating_count")
  completedSales     Int                      @default(0) @map("completed_sales")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  listings Listing[]

  @@index([verificationStatus])
  @@index([ratingAverage])
  @@map("sellers")
}

model Listing {
  id                String        @id @default(uuid()) @db.Uuid
  sellerId          String        @map("seller_id") @db.Uuid
  brand             String        @db.VarChar(80)
  model             String        @db.VarChar(120)
  /// Canonical, human-readable URL segment. Null until backfilled or set on create.
  slug              String?       @unique @db.VarChar(180)
  /// Must be between 2015 and 2024; enforced by a PostgreSQL check constraint.
  year              Int
  price             Decimal       @db.Decimal(12, 2)
  /// Original retail price. Nullable: a discount is only shown when this is
  /// genuinely higher than `price`.
  originalPrice     Decimal?      @map("original_price") @db.Decimal(12, 2)
  /// Denormalised from price and originalPrice so the catalog can sort by
  /// saving percentage in the database. 0 means no genuine saving.
  discountPercent   Int           @default(0) @map("discount_percent")
  /// Must be between 0 and 100; enforced by a PostgreSQL check constraint.
  batteryPercent    Int           @map("battery_percent")
  storage           String        @db.VarChar(64)
  cosmeticCondition String        @default("Good") @map("cosmetic_condition") @db.VarChar(40)
  /// Graded A/B/C scale. Backfilled from `cosmeticCondition` for existing rows.
  conditionGrade    ConditionGrade? @map("condition_grade")
  /// Warranty term in months. 0 means sold as-is, which the UI states plainly.
  warrantyMonths    Int           @default(0) @map("warranty_months")
  color             String?       @map("color") @db.VarChar(80)
  conditionNotes    String        @map("condition_notes") @db.Text
  ram               String?       @db.VarChar(40)
  operatingSystem   String?       @map("operating_system") @db.VarChar(80)
  networkType       String?       @map("network_type") @db.VarChar(80)
  processor         String?       @db.VarChar(120)
  displaySpec       String?       @map("display_spec") @db.VarChar(200)
  cameraSpec        String?       @map("camera_spec") @db.VarChar(240)
  /// Category slugs this phone belongs to, e.g. {iphone, under-20000}.
  categoryTags      String[]      @default([]) @map("category_tags")
  /// The functional checks that passed on this device. Empty means "not recorded",
  /// which the UI presents differently from "recorded and incomplete".
  inspectionChecks  String[]      @default([]) @map("inspection_checks")
  /// IMEI verification status. Only the last four digits are retained.
  imeiVerified      Boolean       @default(false) @map("imei_verified")
  imeiLast4         String?       @map("imei_last4") @db.Char(4)
  /// Units available. Each listing is one physical phone by default.
  quantity          Int           @default(1)
  viewsCount        Int           @default(0) @map("views_count")
  isFeatured        Boolean       @default(false) @map("is_featured")
  /// Ordered image URLs; the first URL is the listing Main Photo.
  photos            String[]      @default([])
  status            ListingStatus @default(PENDING)
  moderatorFeedback String?       @map("moderator_feedback") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inquiries     Inquiry[]
  notifications Notification[]
  favorites     Favorite[]
  reports       Report[]
  reviews       Review[]
  cartItems     CartItem[]
  reservations  Reservation[]

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([brand, model])
  @@index([status, conditionGrade])
  @@index([status, price])
  @@index([status, batteryPercent])
  @@index([status, isFeatured])
  @@index([status, discountPercent])
  @@map("listings")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  listingId        String       @map("listing_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  /// Only set when the reviewer bought this exact device.
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  /// Seeded demo data. Never listed publicly and never counted in an average.
  isSample         Boolean      @default(false) @map("is_sample")
  rating           Int
  title            String?      @db.VarChar(160)
  comment          String       @db.Text
  /// How well the delivered device matched its published condition grade.
  conditionRating  Int?         @map("condition_rating")
  /// How well the buyer rated the seller.
  sellerRating     Int?         @map("seller_rating")
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([listingId, userId])
  @@index([listingId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

model Inquiry {
  id           String   @id @default(uuid()) @db.Uuid
  listingId    String   @map("listing_id") @db.Uuid
  buyerName    String   @map("buyer_name") @db.VarChar(120)
  buyerContact String   @map("buyer_contact") @db.VarChar(320)
  message      String   @db.Text
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  buyerId String? @map("buyer_id") @db.Uuid
  buyer   User?   @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([listingId, createdAt])
  @@index([listingId, isRead])
  @@index([buyerId])
  @@map("inquiries")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  listingId      String       @map("listing_id") @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  reason         ReportReason
  /// Optional for every reason except OTHER, which the API requires.
  details        String?      @db.Text
  status         ReportStatus @default(OPEN)
  resolutionNote String?      @map("resolution_note") @db.Text
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reporter   User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resolvedBy User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([listingId])
  @@map("reports")
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// A ReFon cart. Exactly one owner field is set, enforced by a check constraint.
/// A cart belongs to exactly one signed-in buyer.
///
/// Buying is a buyer action, so there is no guest cart and nothing to merge: a
/// visitor is sent to sign in before a cart exists. `user_id` is therefore NOT NULL
/// and unique, and the endpoint layer additionally requires the BUYER role.
model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items CartItem[]

  @@map("carts")
}

/// One line in a cart. A ReFon listing is a single physical refurbished device,
/// so the unique (cart, listing) pair is what structurally prevents a buyer from
/// holding the same phone twice — no quantity arithmetic can create an impossible
/// amount of one device.
model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  listingId     String   @map("listing_id") @db.Uuid
  /// The listing price when the item was added. Kept so a later price change is
  /// detectable rather than silently applied or silently ignored.
  priceSnapshot Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  quantity      Int      @default(1)
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reservations Reservation[]

  @@unique([cartId, listingId])
  @@index([listingId])
  @@map("cart_items")
}

/// A short-lived hold on one listing so two buyers cannot proceed with the same
/// physical phone.
///
/// A partial unique index on `listing_id` where `released_at IS NULL` is the
/// database-level guarantee that a listing has at most one live hold. Expiry is
/// handled by setting `released_at` rather than by deleting, because the index
/// predicate would otherwise keep the slot taken by a lapsed reservation.
model Reservation {
  id         String    @id @default(uuid()) @db.Uuid
  listingId  String    @map("listing_id") @db.Uuid
  cartItemId String    @map("cart_item_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listing  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([listingId, releasedAt])
  @@index([cartItemId])
  @@index([expiresAt, releasedAt])
  @@map("reservations")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  /// Only the SHA-256 hash is stored; the raw token is emailed once.
  tokenHash String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  type             NotificationType
  message          String           @db.Text
  relatedListingId String?          @map("related_listing_id") @db.Uuid
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  relatedListing Listing? @relation(fields: [relatedListingId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// One visitor finishing at least one phone health check. Anonymous on purpose:
/// it powers the "phones checked today" counter and stores nothing about the
/// visitor or their device.
model HealthCheckRun {
  id        String   @id @default(uuid()) @db.Uuid
  passed    Int      @default(0) @db.SmallInt
  completed Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("health_check_runs")
}
