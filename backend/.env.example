NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/refon?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"

UPLOAD_DIR="uploads"

# Where listing photos are stored: "local" writes to backend/uploads and needs a
# persistent volume in production, "s3" uses any S3-compatible bucket and is the
# right choice for platforms with an ephemeral filesystem.
STORAGE_DRIVER="local"
# Required when STORAGE_DRIVER=s3.
S3_BUCKET=""
S3_REGION=""
# Set for Cloudflare R2, Backblaze B2, or MinIO. Leave empty for real AWS S3.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# MinIO and some B2 setups need path-style addressing.
S3_FORCE_PATH_STYLE=false
S3_PREFIX="uploads/"

# Public base URL of the frontend, used to build links inside account emails.
APP_URL="http://localhost:5173"
MAIL_FROM="ReFon <no-reply@refon.test>"
# Leave SMTP_HOST empty outside production: emails are appended to
# backend/tmp/mail-outbox.jsonl instead. Production requires a relay.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
