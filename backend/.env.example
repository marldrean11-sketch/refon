NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/refon?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"

UPLOAD_DIR="uploads"

# Public base URL of the frontend, used to build links inside account emails.
APP_URL="http://localhost:5173"
MAIL_FROM="ReFon <no-reply@refon.test>"
# Leave SMTP_HOST empty outside production: emails are appended to
# backend/tmp/mail-outbox.jsonl instead. Production requires a relay.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
